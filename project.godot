; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Giroflée"
config/version="0.1.0"
run/main_scene="res://src/ui/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/branding/logo.svg"
boot_splash/image="res://assets/branding/splash.png"
boot_splash/bg_color=Color(0.937255, 0.945098, 0.960784, 1)
boot_splash/show_image=true
boot_splash/fullsize=false
boot_splash/use_filter=true

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.901961, 0.913725, 0.937255, 1)
