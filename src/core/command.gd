class_name Command
extends RefCounted
## A serialisable request to change the document (SRD ARCH-3). All ids are generated by the
## client before submission, so applying a command is deterministic.

var id: String = ""
var type: String = ""
var payload: Dictionary = {}
## Gesture/transaction id; commands sharing it are one undo step.
var tx: String = ""
var author: String = ""


static func make(p_type: String, p_payload: Dictionary, p_id: String, p_tx: String = "", p_author: String = "") -> Command:
	var command: Command = Command.new()
	command.type = p_type
	command.payload = p_payload
	command.id = p_id
	command.tx = p_tx
	command.author = p_author
	return command


func to_dict() -> Dictionary:
	return {"id": id, "type": type, "payload": payload.duplicate(true), "tx": tx, "author": author}


## Returns "" when `data` can become a Command, else a message.
static func validate_dict(data: Dictionary) -> String:
	if not JsonUtil.has_string(data, "type") or str(data["type"]).is_empty():
		return "command needs a type"
	if data.has("payload") and not (data["payload"] is Dictionary):
		return "payload must be an object"
	for key: String in ["id", "tx", "author"]:
		if data.has(key) and not (data[key] is String):
			return "%s must be a string" % key
	return ""


## Builds a command from a dictionary that passed `validate_dict`.
## `fallback_id` is used when the dictionary has no id (hand-written scripts).
static func from_dict(data: Dictionary, fallback_id: String = "") -> Command:
	var p_type: String = data["type"]
	var p_payload: Dictionary = data.get("payload", {})
	var p_id: String = data.get("id", fallback_id)
	var p_tx: String = data.get("tx", "")
	var p_author: String = data.get("author", "")
	return make(p_type, p_payload.duplicate(true), p_id, p_tx, p_author)
